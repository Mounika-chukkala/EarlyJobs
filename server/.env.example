PORT=5000

# --- Database ---
# Local demo (no MongoDB): memory
# MongoDB Atlas (recommended): paste your connection string below
# Example:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/earlyjobs_ats?retryWrites=true&w=majority
MONGODB_URI=memory

# Seed empty Atlas/local DB on startup (set false to skip)
AUTO_SEED=true

CLIENT_ORIGIN=http://localhost:5173
